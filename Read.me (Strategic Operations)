💻 Sample SQL Insight: Industry Risk Audit
SQL
-- Identifying the 'Weakest Link' industries based on Average Health
SELECT industry, 
       AVG(health_score) as avg_health,
       SUM(monthly_billable) as total_revenue
FROM consulting_df
GROUP BY industry
ORDER BY avg_health ASC;
